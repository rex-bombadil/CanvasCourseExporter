{
  "Canvas": {
    // Your Canvas instance URL (no trailing slash)
    "BaseUrl": "https://YOUR_INSTANCE.instructure.com",

    // API token — generate at https://YOUR_INSTANCE.instructure.com/profile/settings
    // SECURITY: In production, move this to a secret manager (DPAPI, Azure Key Vault, etc.)
    "ApiToken": "YOUR_API_TOKEN_HERE"
  },

  "Export": {
    // Where to write archived course packages and files
    // Can be a local path, UNC share, or mounted cloud storage
    "OutputFolder": "C:\\CanvasArchive",

    // Days between re-exports for courses without a per-course interval
    // The course selection view can override this per course via export_interval_days
    "ReExportAfterDays": 7,

    // How many courses to export simultaneously
    // Higher = faster but more API pressure. Start with 3-5.
    "MaxConcurrent": 5,

    // Whether to unpack .imscc packages into human-readable folders
    // The .imscc file is always kept regardless of this setting
    "Unpack": true,

    // Whether to keep the .imscc package after unpacking
    // Recommended: true (it's the only machine-restorable artifact)
    "KeepPackage": true,

    // Organize output by term subfolder (e.g., OutputFolder/Fall2025/COURSE_CODE/)
    "OrganizeByTerm": false,

    // Seconds between status polls while waiting for Canvas to finish exporting
    "PollIntervalSeconds": 5,

    // Maximum seconds to wait for a single course export before timing out
    "MaxWaitSeconds": 600,

    // Enable/disable the file attachment downloader (Phase 2)
    "FileDownloadEnabled": true,

    // Optional: SQL override for course selection query
    // If blank, uses the default view: canvas_courses_to_export
    // "CourseQuery": "SELECT canvas_id, course_id, 7 AS export_interval_days FROM my_custom_table"
    "CourseQuery": ""
  },

  "ConnectionStrings": {
    // Operational database for scheduling and tracking
    // Replace with your provider's connection string
    // Oracle example:
    "Oracle": "Data Source=YOUR_ORACLE_HOST:1521/YOUR_SERVICE;User Id=YOUR_USER;Password=YOUR_PASSWORD;",

    // Canvas Data 2 tables (SQL Server)
    "SqlServer": "Server=YOUR_SQL_SERVER;Database=YOUR_CD2_DATABASE;Trusted_Connection=true;TrustServerCertificate=true;"
  }
}

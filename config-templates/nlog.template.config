<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <targets>
    <!-- Console output for interactive runs -->
    <target name="console" xsi:type="ColoredConsole"
            layout="${date:format=HH\:mm\:ss} ${level:uppercase=true:padding=-5} ${logger:shortName=true} ${message} ${exception:format=Message}" />

    <!-- Rolling file log -->
    <target name="file" xsi:type="File"
            fileName="${basedir}/logs/canvas-export-${shortdate}.log"
            layout="${longdate} ${level:uppercase=true:padding=-5} [${logger:shortName=true}] ${message} ${exception:format=tostring}"
            archiveAboveSize="10485760"
            maxArchiveFiles="30" />

    <!-- Email on errors — uses BufferingWrapper to batch errors into one email -->
    <!-- Remove or comment out this section if you don't need email notifications -->
    <!--
    <target name="mail" xsi:type="BufferingWrapper" bufferSize="50" flushTimeout="60000">
      <target xsi:type="Mail"
              smtpServer="YOUR_SMTP_SERVER"
              smtpPort="25"
              smtpAuthentication="None"
              from="canvas-export@yourinstitution.edu"
              to="admin@yourinstitution.edu"
              subject="Canvas Course Exporter - Errors"
              layout="${longdate} ${level:uppercase=true} ${message} ${exception:format=tostring}"
              html="false" />
    </target>
    -->
  </targets>

  <rules>
    <!-- Debug and above to file -->
    <logger name="*" minlevel="Debug" writeTo="file" />

    <!-- Info and above to console -->
    <logger name="*" minlevel="Info" writeTo="console" />

    <!-- Errors to email (uncomment mail target above first) -->
    <!-- <logger name="*" minlevel="Error" writeTo="mail" /> -->
  </rules>

</nlog>
